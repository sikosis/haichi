resource app_signature "application/x-vnd.Sikosis-haichi";

resource app_flags B_MULTIPLE_LAUNCH;

resource(101, "BEOS:ICON") #'VICN' import "haichi.hvif";

resource app_version {
	major = 0,
	middle = 1,
	minor = 2,
	variety = B_APPV_DEVELOPMENT,
	internal = 12,
	short_info = "haichi v0.12",
	long_info = "haichi Desktop icon placer v0.12"
};
